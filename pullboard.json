{
  "gate": "markdownlint-cli2 SPEC.md DOCTRINE.md AGENTS.md README.md 2>/dev/null || true",
  "spec": "SPEC.md",
  "practice": "DOCTRINE.md",
  "worktrees": "inside",
  "verify": {
    "policy": "any",
    "family": "off"
  },
  "agents": {
    "names": "suffix"
  },
  "lease": "2h",
  "lanes": {
    "review": {
      "owns": [],
      "starts": "any time: verifiers check submitted work and own no folders"
    }
  },
  "shared": [],
  "commits": {
    "requireIds": [
      "feat",
      "fix"
    ]
  },
  "checks": {
    "provesNothing": "hold"
  },
  "landing": {
    "publish": "separate"
  }
}
